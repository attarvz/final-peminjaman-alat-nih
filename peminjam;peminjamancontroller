
<?php

namespace App\Http\Controllers\Peminjam;

use App\Http\Controllers\Controller;
use App\Models\Peminjaman;
use App\Models\DetailPeminjaman;
use App\Models\Alat;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use RuntimeException;
use Carbon\Carbon;

class PeminjamanController extends Controller
{
    // DAFTAR PEMINJAMAN
    public function index()
    {
        $peminjaman = Peminjaman::with([
            'user',
            'detailPeminjaman.alat',
            'pengembalian',
        ])
        ->where('user_id', auth()->id())
        ->latest()
        ->get();

        return view('peminjam.peminjaman.index', compact('peminjaman'));
    }

    // FORM PENGAJUAN
    public function create()
    {
        $alat = Alat::where('stok', '>', 0)->get();

        return view('peminjam.peminjaman.create', compact('alat'));
    }

    // SIMPAN PENGAJUAN
    public function store(Request $request)
    {
        $request->validate([
            'tanggal_pinjam' => 'required|date|after_or_equal:today',

            'tanggal_batas_kembali' => [
                'required',
                'date',
                'after:tanggal_pinjam',

                function ($attribute, $value, $fail) use ($request) {

                    if (!$request->tanggal_pinjam) {
                        return;
                    }

                    $tanggalPinjam = Carbon::parse(
                        $request->tanggal_pinjam
                    )->startOfDay();

                    $tanggalMaksimal = $tanggalPinjam->copy()->addMonth();

                    $tanggalKembali = Carbon::parse(
                        $value
                    )->startOfDay();

                    if ($tanggalKembali->greaterThan($tanggalMaksimal)) {
                        $fail(
                            'Maksimal peminjaman hanya 1 bulan dari tanggal pinjam.'
                        );
                    }
                },
            ],

            'id_alat' => 'required|exists:alat,id_alat',
            'jumlah' => 'required|integer|min:1',
        ]);

        try {
            DB::transaction(function () use ($request) {

                $alat = Alat::where('id_alat', $request->id_alat)
                    ->lockForUpdate()
                    ->firstOrFail();

                if ($alat->stok < $request->jumlah) {
                    throw new RuntimeException(
                        'Jumlah alat melebihi stok yang tersedia.'
                    );
                }

                $peminjaman = Peminjaman::create([
                    'user_id' => auth()->id(),
                    'tanggal_pinjam' => $request->tanggal_pinjam,
                    'tanggal_batas_kembali' => $request->tanggal_batas_kembali,
                    'status' => 'menunggu',
                ]);

                DetailPeminjaman::create([
                    'id_peminjaman' => $peminjaman->id_peminjaman,
                    'id_alat' => $alat->id_alat,
                    'jumlah' => $request->jumlah,
                ]);
            });

        } catch (RuntimeException $e) {
            return back()->withInput()->with('error', $e->getMessage());
        }

        return redirect('/peminjam/peminjaman')
            ->with('success', 'Pengajuan peminjaman berhasil dikirim!');
    }
}
